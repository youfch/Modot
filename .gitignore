project.lock.json
project.fragment.lock.json
*.binlog
*.tlog
*.cache
*.log

# ===== 测试与覆盖率 =====
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# ===== Godot 4 =====
.godot/
.import/
export_presets.cfg
*.translation
mono_crash.*.json
/android/

# ===== Godot 3 历史遗留（仓库内仍可能残留 .mono/） =====
.mono/

# ===== Visual Studio =====
.vs/
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.sln.ide/
*.VC.db
*.VC.VC.opendb

# ===== VS Code =====
.vscode/

# ===== Rider / ReSharper / Fleet =====
.idea/
.fleet/
*.sln.iml
_ReSharper*/
*.DotSettings.user

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 本机工具与本地索引（不入库） =====
.omo/
.codegraph/
scripts/pack-local.ps1

# ===== e2e 测试的构建产出（由 runner 组装生成，不入库） =====
tests/e2e/Mods/*/Assemblies/
# 编辑器为 mod 项目生成的解决方案文件（仓库用它自己的 Modot.sln）
tests/e2e/Mods/*/*.sln
# 例外：e2e 的 mod 项目要靠这个预设才能重建 pck（官方模板默认忽略 export_presets.cfg）
!tests/e2e/Mods/*/export_presets.cfg
